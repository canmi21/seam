* text=auto eol=lf

# Source taken from SvelteKit is theirs, and the statistics describe what is written here. GitHub
# leaves a `vendor/` out by default; said here so that it holds whatever the directory is called.
# See vendor/README.md.
vendor/** linguist-vendored=true

# The fork of SvelteKit is the same code, kept in upstream's shape so that upstream's diff merges
# into it; what is written here is the call points it lists. See pkgs/framework/FORK.md.
pkgs/framework/** linguist-vendored=true

# Written by `mise run regenerate` from the `.svelte` beside each, and read by the checks on both
# sides: a build's output, not authored.
corpus/cases/*.json linguist-generated=true
pkgs/suite/baseline.json linguist-generated=true

# Over the workspace's hard limit and owed a split by section, not taken today. See todo.md, "Also
# open".
spec/refusals.md lines=deferred
spec/derivation.md lines=deferred
spec/readings.md lines=deferred
