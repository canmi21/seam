{
	"name": "@seam-js/injector",
	"version": "0.0.1",
	"description": "Fills the IR with a request's values into the bytes Svelte would render, for seamjs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canmi21/seam.git",
		"directory": "pkgs/injector"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"devDependencies": {
		"@seam-js/ast": "workspace:*",
		"@seam-js/carry": "workspace:*",
		"@seam-js/derive": "workspace:*",
		"@seam-js/skeleton": "workspace:*",
		"svelte": "^5.57.1"
	},
	"peerDependencies": {
		"svelte": "*"
	},
	"engines": {
		"node": ">=22.17"
	}
}
