{
	"name": "@seam-js/plugin",
	"version": "0.0.2",
	"description": "Compile-time rendering for SvelteKit, as a Vite plugin: beside Kit's own, or called from the framework's",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canmi21/seam.git",
		"directory": "pkgs/plugin"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"dependencies": {
		"@seam-js/carry": "workspace:*",
		"@seam-js/compiler": "workspace:*",
		"@seam-js/program": "workspace:*",
		"@seam-js/routes": "workspace:*",
		"@seam-js/runtime": "workspace:*",
		"@seam-js/skeleton": "workspace:*"
	},
	"devDependencies": {
		"@seam-js/stream": "workspace:*",
		"@sveltejs/kit": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"vite": "^8.3.2"
	},
	"peerDependencies": {
		"@sveltejs/kit": "3.0.0",
		"svelte": "*",
		"vite": "^8.0.0"
	},
	"engines": {
		"node": ">=22.17"
	}
}
