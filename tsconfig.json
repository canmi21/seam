{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["node"],
		"allowJs": true,
		"paths": {
			"types": ["./vendor/kit/src/types/internal.d.ts"]
		}
	},
	"include": ["pkgs/*/src/**/*.ts", "corpus/*.ts"]
}
